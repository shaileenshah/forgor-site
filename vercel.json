{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/join/:code",
      "destination": "/join/index.html"
    },
    {
      "source": "/calendar/google",
      "destination": "https://dnizwlgxoyjkfwkoydth.supabase.co/functions/v1/calendar-connect/callback"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
